<?xml version="1.0" encoding="UTF-8"?>
<fmiModelDescription
  fmiVersion="3.0"
  modelName="ifog_core"
  instantiationToken="@IFOG_FMI_INSTANTIATION_TOKEN@"
  description="Closed-Loop IFOG Multi-Scale Virtual Prototype (IFOG-SIM-SPEC-007 / SPEC-006 — IEEE 1666.1 SystemC/SystemC-AMS Co-Simulation FMU)"
  author="ifog-vproto engineering"
  version="@IFOG_PROJECT_VERSION@"
  generationTool="ifog-vproto CMake FMI 3.0 Packager"
  generationDateAndTime="@IFOG_FMU_BUILD_TIMESTAMP@"
  variableNamingConvention="flat">

  <CoSimulation
    modelIdentifier="ifog_core"
    canHandleVariableCommunicationStepSize="true"
    canBeInstantiatedOnlyOncePerProcess="true"
    hasEventMode="false"
    providesIntermediateUpdate="false"/>

  <UnitDefinitions>
    <Unit name="s">
      <BaseUnit s="1"/>
    </Unit>
    <Unit name="m">
      <BaseUnit m="1"/>
    </Unit>
    <Unit name="rad">
      <BaseUnit rad="1"/>
    </Unit>
    <Unit name="rad/s">
      <BaseUnit rad="1" s="-1"/>
    </Unit>
    <Unit name="1">
      <BaseUnit/>
    </Unit>
    <Unit name="A/V">
      <BaseUnit kg="-1" m="-2" s="3" A="2"/>
    </Unit>
    <Unit name="S">
      <BaseUnit kg="-1" m="-2" s="3" A="2"/>
    </Unit>
    <Unit name="F">
      <BaseUnit kg="-1" m="-2" s="4" A="2"/>
    </Unit>
    <Unit name="dB">
      <BaseUnit/>
    </Unit>
    <Unit name="ppm/K">
      <BaseUnit K="-1" factor="1e-6"/>
    </Unit>
  </UnitDefinitions>

  <LogCategories>
    <Category name="logEvents" description="Log FMI 3.0 lifecycle and initialization events"/>
    <Category name="logStatusError" description="Log FMI 3.0 errors and invalid API arguments"/>
  </LogCategories>

  <DefaultExperiment startTime="0.0" stopTime="1.0" stepSize="1.0e-3"/>

  <ModelVariables>
    <Float64 name="time" valueReference="0" causality="independent" variability="continuous" unit="s" description="Independent simulation time"/>
    <Float64 name="omega_in" valueReference="1" causality="input" variability="continuous" unit="rad/s" start="0.0" description="External angular rate input Omega_in(t) held ZOH across macro communication step"/>
    <Float64 name="shupe_phase_in" valueReference="2" causality="input" variability="continuous" unit="rad" start="0.0" description="External thermal Shupe non-reciprocal phase perturbation Delta_phi_Shupe(t)"/>
    <Float64 name="omega_out" valueReference="3" causality="output" variability="continuous" initial="calculated" unit="rad/s" description="Instantaneous closed-loop digital angular rate output Omega_out(t)"/>
    <Float64 name="e_vpi_res" valueReference="4" causality="output" variability="continuous" initial="calculated" unit="rad" description="Loop-2 residual 2*pi flyback V_pi phase error 2*pi*eps_Vpi_eff"/>
    <UInt32 name="bit_status" valueReference="5" causality="output" variability="discrete" initial="calculated" description="Real-time FPGA BIT/FDIR and saturation status bitmask (0 = healthy)"/>
    <Float64 name="eps_vpi" valueReference="6" causality="parameter" variability="tunable" unit="1" start="0.02" description="MIOC half-wave voltage fractional scale error eps_Vpi"/>
    <Float64 name="k_xtalk" valueReference="7" causality="parameter" variability="tunable" unit="A/V" start="1.0e-8" description="DAC-to-TIA resistive crosstalk conductance k_xtalk"/>
    <Boolean name="enable_dither" valueReference="8" causality="parameter" variability="tunable" start="true" description="Enable 32-bit LFSR PRBS dither for deadband suppression"/>
    <Int32 name="dsp_mode" valueReference="9" causality="parameter" variability="fixed" start="4" description="Digital demodulation mode: 2 (2-state), 4 (4-state Lefevre), or 6 (6-state symmetric)"/>
    <Boolean name="en_white_noise" valueReference="10" causality="parameter" variability="fixed" start="true" description="Enable 6-component TIA shot, RIN, thermal, and op-amp white noise (EQ-15)"/>
    <Boolean name="en_pink_noise" valueReference="11" causality="parameter" variability="fixed" start="false" description="Enable 5-pole IIR 1/f flicker noise in TIA, DAC, and crosstalk"/>
    <Boolean name="en_vpi_loop" valueReference="12" causality="parameter" variability="fixed" start="true" description="Enable Loop-2 V_pi closed-loop gain tracking"/>
    <Int32 name="seed" valueReference="13" causality="parameter" variability="fixed" start="42004" description="Deterministic PRNG and LFSR seed matching baseline_1km.json"/>
    <Float64 name="omega_out_avg" valueReference="14" causality="output" variability="continuous" initial="calculated" unit="rad/s" description="Anti-aliased macro-step interval-averaged angular rate output (EQ-42)"/>
    <Float64 name="C_xtalk_F" valueReference="15" causality="parameter" variability="tunable" unit="F" start="2.0e-12" description="SPEC-007 capacitive PCB/package DAC-to-TIA crosstalk capacitance C_xtalk (EQ-51)"/>
    <Float64 name="G_xtalk_S" valueReference="16" causality="parameter" variability="tunable" unit="S" start="1.0e-8" description="SPEC-007 resistive DAC-to-TIA leakage conductance G_xtalk (EQ-51)"/>
    <Float64 name="c_pink_coeff" valueReference="17" causality="parameter" variability="tunable" unit="1" start="1.0" description="SPEC-007 tunable 1/f flicker noise amplitude scale multiplier c_pink_coeff (EQ-53)"/>
    <Float64 name="R_facet_dB" valueReference="18" causality="parameter" variability="tunable" unit="dB" start="-200.0" description="SPEC-007 residual MIOC pigtail facet power reflectivity R_facet [dB] (EQ-52)"/>
    <Float64 name="alpha_vpi_ppm_K" valueReference="19" causality="parameter" variability="tunable" unit="ppm/K" start="0.0" description="SPEC-007 MIOC half-wave voltage thermal coefficient alpha_Vpi [ppm/K] (EQ-48)"/>
    <Float64 name="alpha_bobbin_ppm_K" valueReference="20" causality="parameter" variability="tunable" unit="ppm/K" start="0.0" description="SPEC-007 fiber bobbin thermal expansion coefficient alpha_bobbin [ppm/K] (EQ-47)"/>
    <Float64 name="delta_z_quad_m" valueReference="21" causality="parameter" variability="tunable" unit="m" start="0.002" description="SPEC-007 quadrupole/octupole winding asymmetry residual delta_z_quad [m] (EQ-45)"/>
  </ModelVariables>

  <ModelStructure>
    <Output valueReference="3"/>
    <Output valueReference="4"/>
    <Output valueReference="5"/>
    <Output valueReference="14"/>
    <InitialUnknown valueReference="3"/>
    <InitialUnknown valueReference="4"/>
    <InitialUnknown valueReference="5"/>
    <InitialUnknown valueReference="14"/>
  </ModelStructure>
</fmiModelDescription>
